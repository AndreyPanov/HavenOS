{
    "id": "haven.unit.test-web",
    "bundleID": "haven.bundle.test-library-basic",
    "runtimeType": "binary",
    "installSource": "/opt/haven/bin/test-web",
    "launchArguments": [
        "/opt/haven/bin/test-web",
        "--port",
        "${port}"
    ],
    "healthcheck": {
        "type": "http",
        "target": "http://localhost:${port}/health",
        "intervalSeconds": 15,
        "retries": 3
    },
    "port": 8080,
    "dependsOn": ["haven.unit.test-worker"],
    "environment": {
        "WEB_PORT": "${port}",
        "WEB_DATA": "${data_path}",
        "WEB_LOGS": "${logs_dir}"
    }
}
