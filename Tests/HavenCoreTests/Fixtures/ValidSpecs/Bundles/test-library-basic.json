{
    "id": "haven.bundle.test-library-basic",
    "name": "Test Library (Basic)",
    "capability": "haven.capability.test-library",
    "runtimeUnits": [
        "haven.unit.test-db",
        "haven.unit.test-worker",
        "haven.unit.test-web"
    ],
    "settings": [
        {
            "key": "data_path",
            "label": "Data directory path",
            "fieldType": "path",
            "defaultValue": "/srv/data",
            "required": true
        },
        {
            "key": "port",
            "label": "HTTP port",
            "fieldType": "integer",
            "defaultValue": "8080",
            "required": false
        }
    ]
}
